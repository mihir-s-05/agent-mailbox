# Native Linux deployment behind a TLS reverse proxy on the same machine.
# Copy to /etc/agent-mailbox/mailbox.env; restrict to root and agent-mailbox.
MAILBOX_ADDR=127.0.0.1:8443
MAILBOX_BASE_PATH=/mcp
MAILBOX_DATABASE_URL=postgres://agent_mailbox:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/agent_mailbox?sslmode=disable
MAILBOX_TLS_ENABLED=false
MAILBOX_REQUIRE_MTLS=false
MAILBOX_TOKENS_JSON_FILE=/etc/agent-mailbox/tokens.json
MAILBOX_AUTO_GENERATE_TOKENS=false
MAILBOX_ALLOW_PLAINTEXT_TOKENS=false
MAILBOX_EVENT_KEY_FILE=/var/lib/agent-mailbox/events.key
MAILBOX_TOKEN_RELOAD_INTERVAL=15s
